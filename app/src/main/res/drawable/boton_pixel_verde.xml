<?xml version="1.0" encoding="utf-8"?>
<!-- Ver boton_pixel_azul.xml para la explicación del patrón. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <inset android:insetLeft="4dp" android:insetTop="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/pixel_verde" />
                <stroke android:width="3dp" android:color="@color/pixel_tinta" />
            </shape>
        </inset>
    </item>

    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/pixel_tinta" />
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/pixel_verde" />
                    <stroke android:width="3dp" android:color="@color/pixel_tinta" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
