<?xml version="1.0" encoding="utf-8"?>
<!-- Primera fila (mejor resultado): fondo crema; al presionar se oscurece. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E7DAC1" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_fondo" />
        </shape>
    </item>
</selector>
