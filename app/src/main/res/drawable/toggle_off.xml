<?xml version="1.0" encoding="utf-8"?>
<!-- Toggle apagado: pista gris, perilla a la izquierda. 52x26dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_dither" />
            <stroke android:width="3dp" android:color="@color/pixel_tinta" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="28dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_fondo" />
            <stroke android:width="2dp" android:color="@color/pixel_tinta" />
        </shape>
    </item>
</layer-list>
