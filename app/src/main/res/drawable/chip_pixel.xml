<?xml version="1.0" encoding="utf-8"?>
<!-- Chip retro: seleccionado = relleno tinta; sin seleccionar = contorno 2dp tinta. Radio 0. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_tinta" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/pixel_tinta" />
        </shape>
    </item>
</selector>
