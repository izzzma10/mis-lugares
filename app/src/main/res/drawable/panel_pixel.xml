<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor / tarjeta retro: fondo blanco, contorno 3dp tinta, sombra sólida 4dp.
     Radio 0. Sin elevation. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_tinta" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="3dp" android:color="@color/pixel_tinta" />
        </shape>
    </item>
</layer-list>
