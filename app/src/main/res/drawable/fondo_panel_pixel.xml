<?xml version="1.0" encoding="utf-8"?>
<!-- Panel de sugerencias: sombra sólida 4dp + relleno blanco + contorno 3dp tinta. Radio 0. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#59241C10" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="3dp" android:color="@color/pixel_tinta" />
        </shape>
    </item>
</layer-list>
