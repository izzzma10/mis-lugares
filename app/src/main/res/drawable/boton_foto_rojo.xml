<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de 32dp para borrar foto: relleno rojo, contorno 2dp tinta. Radio 0. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pixel_rojo" />
    <stroke android:width="2dp" android:color="@color/pixel_tinta" />
    <corners android:radius="0dp" />
</shape>
