<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de escape: fondo crema con borde superior 2dp tinta. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_tinta" />
        </shape>
    </item>
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_fondo" />
        </shape>
    </item>
</layer-list>
