<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de tabs inferior de 56dp, reutilizable con <include>.
     3 celdas iguales separadas por bordes de 3dp. La celda activa se marca
     desde código con setSelected(true) sobre tab_lista / tab_mapa / tab_ajustes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/pixel_tinta" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/pixel_fondo">

        <LinearLayout
            android:id="@+id/tab_lista"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/celda_tab"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tab_lista"
                android:tint="@color/tab_contenido" />

            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:text="LISTA"
                android:textColor="@color/tab_contenido" />
        </LinearLayout>

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/pixel_tinta" />

        <LinearLayout
            android:id="@+id/tab_mapa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/celda_tab"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tab_mapa"
                android:tint="@color/tab_contenido" />

            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:text="MAPA"
                android:textColor="@color/tab_contenido" />
        </LinearLayout>

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/pixel_tinta" />

        <LinearLayout
            android:id="@+id/tab_ajustes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/celda_tab"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tab_ajustes"
                android:tint="@color/tab_contenido" />

            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:duplicateParentState="true"
                android:text="AJUSTES"
                android:textColor="@color/tab_contenido" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
