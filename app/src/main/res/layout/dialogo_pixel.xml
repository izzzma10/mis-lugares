<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo pixel. El color de la franja y del botón de acción se ponen desde DialogosPixel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/fondo_dialogo_pixel">

    <!-- Franja de título -->
    <LinearLayout
        android:id="@+id/franja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/pixel_tinta"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/dialogo_icono"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@color/pixel_amarillo"
            android:fontFamily="@font/silkscreen"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="!"
            android:textColor="@color/pixel_tinta"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/silkscreen"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:textColor="@color/pixel_fondo"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Cuerpo -->
    <TextView
        android:id="@+id/mensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vt323"
        android:lineSpacingMultiplier="1.25"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="13dp"
        android:paddingBottom="15dp"
        android:textColor="@color/pixel_tinta"
        android:textSize="19sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/pixel_tinta" />

    <!-- Botonera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancelar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/pixel_fondo"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/silkscreen"
            android:gravity="center"
            android:text="CANCELAR"
            android:textAllCaps="true"
            android:textColor="@color/pixel_tinta"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/pixel_tinta" />

        <TextView
            android:id="@+id/btn_accion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/pixel_rojo"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/silkscreen"
            android:gravity="center"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
