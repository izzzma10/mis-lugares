<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/barra_pixel" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/contenedor_lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/fab_agregar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/boton_pixel_verde"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/agregar_lugar"
            android:fontFamily="@font/silkscreen"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Ciclador de radio de búsqueda: ocupa el mismo lugar que el "+", solo
             uno de los dos está visible a la vez (lo maneja ListaLugaresFragment
             según el chip "CERCA"). Rectángulo horizontal ("acostado") para que
             entren el número y "KM" en una sola línea. -->
        <TextView
            android:id="@+id/fab_radio"
            android:layout_width="110dp"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/boton_pixel_azul"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/radio_busqueda_descripcion"
            android:fontFamily="@font/silkscreen"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <include layout="@layout/barra_tabs" />

</LinearLayout>
