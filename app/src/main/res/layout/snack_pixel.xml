<?xml version="1.0" encoding="utf-8"?>
<!-- Snackbar pixel, anclado abajo. Icono y texto se ponen desde SnackPixel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/snack_pixel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/fondo_snack_pixel"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <ImageView
        android:id="@+id/snack_icono"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:background="@color/pixel_verde"
        android:importantForAccessibility="no"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_check_pixel" />

    <TextView
        android:id="@+id/snack_texto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:fontFamily="@font/silkscreen"
        android:lineSpacingMultiplier="1.5"
        android:textAllCaps="true"
        android:textColor="@color/pixel_fondo"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
