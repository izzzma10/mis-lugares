<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de lista retro: 56dp de contenido + 2dp de divisor = 58dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/pixel_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- Pin de tipo -->
        <ImageView
            android:id="@+id/foto"
            android:layout_width="18dp"
            android:layout_height="22dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@string/logo_del_tipo"
            android:src="@drawable/ic_pin_otros" />

        <!-- Columna central: nombre (+ estrella de favorito) y dirección -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/favorito"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_estrella_llena"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/nombre"
                    style="@style/TextoNombreLista"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/direccion"
                style="@style/TextoDireccionFila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Columna derecha: 5 estrellas + distancia -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:id="@+id/contenedor_estrellas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView android:id="@+id/estrella_1" android:layout_width="9dp" android:layout_height="9dp" android:importantForAccessibility="no" android:src="@drawable/ic_estrella_vacia" />
                <ImageView android:id="@+id/estrella_2" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="1dp" android:importantForAccessibility="no" android:src="@drawable/ic_estrella_vacia" />
                <ImageView android:id="@+id/estrella_3" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="1dp" android:importantForAccessibility="no" android:src="@drawable/ic_estrella_vacia" />
                <ImageView android:id="@+id/estrella_4" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="1dp" android:importantForAccessibility="no" android:src="@drawable/ic_estrella_vacia" />
                <ImageView android:id="@+id/estrella_5" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginStart="1dp" android:importantForAccessibility="no" android:src="@drawable/ic_estrella_vacia" />
            </LinearLayout>

            <TextView
                android:id="@+id/distancia"
                style="@style/TextoDistancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/pixel_divisor" />

</LinearLayout>
