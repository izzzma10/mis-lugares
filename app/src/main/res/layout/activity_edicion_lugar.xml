<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pixel_fondo">

    <include layout="@layout/barra_pixel" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- NOMBRE -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/etiqueta_amarilla"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/campo_nombre"
                android:textColor="@color/pixel_tinta" />

            <EditText
                android:id="@+id/campo_nombre"
                style="@style/TextoCorrido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_pixel"
                android:hint="@string/hint_nombre"
                android:inputType="text|textCapWords"
                android:minHeight="44dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:textColor="@color/pixel_tinta"
                android:textColorHint="@color/pixel_hint"
                android:textCursorDrawable="@drawable/cursor_pixel"
                android:textSize="18sp" />

            <!-- Panel de sugerencias de ubicación (se muestra bajo el input) -->
            <LinearLayout
                android:id="@+id/panel_sugerencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/fondo_panel_pixel"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/pixel_tinta"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/silkscreen_bold"
                        android:letterSpacing="0.1"
                        android:text="@string/sugerencias_titulo"
                        android:textColor="@color/pixel_fondo"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/contador_sugerencias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/silkscreen_bold"
                        android:textColor="@color/pixel_amarillo"
                        android:textSize="8sp" />
                </LinearLayout>

                <com.example.mislugares.presentacion.RecyclerSugerencias
                    android:id="@+id/lista_sugerencias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <LinearLayout
                    android:id="@+id/fila_usar_tal_cual"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/fondo_fila_escape"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@color/pixel_tinta"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_lapiz_pixel" />

                    <TextView
                        android:id="@+id/texto_usar_tal_cual"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="9dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/vt323"
                        android:maxLines="1"
                        android:textColor="@color/pixel_tinta_suave"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/error_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="4dp"
                android:fontFamily="@font/vt323"
                android:textColor="@color/pixel_rojo"
                android:textSize="16sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="11dp" />

            <!-- DIRECCION -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/etiqueta_amarilla"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/campo_direccion"
                android:textColor="@color/pixel_tinta" />

            <EditText
                android:id="@+id/campo_direccion"
                style="@style/TextoCorrido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="11dp"
                android:background="@drawable/input_pixel"
                android:hint="@string/hint_direccion"
                android:minHeight="44dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:textColor="@color/pixel_tinta"
                android:textColorHint="@color/pixel_hint"
                android:textCursorDrawable="@drawable/cursor_pixel"
                android:textSize="18sp" />

            <!-- TEL + WEB -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextoEtiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/etiqueta_amarilla"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="@string/campo_tel"
                        android:textColor="@color/pixel_tinta" />

                    <EditText
                        android:id="@+id/campo_telefono"
                        style="@style/TextoCorrido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_pixel"
                        android:hint="@string/hint_tel"
                        android:inputType="phone"
                        android:minHeight="44dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:textColor="@color/pixel_tinta"
                        android:textColorHint="@color/pixel_hint"
                        android:textCursorDrawable="@drawable/cursor_pixel"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextoEtiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/etiqueta_amarilla"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="@string/campo_web"
                        android:textColor="@color/pixel_tinta" />

                    <EditText
                        android:id="@+id/campo_web"
                        style="@style/TextoCorrido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_pixel"
                        android:hint="@string/hint_web"
                        android:inputType="textUri"
                        android:minHeight="44dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:textColor="@color/pixel_tinta"
                        android:textColorHint="@color/pixel_hint"
                        android:textCursorDrawable="@drawable/cursor_pixel"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- GPS -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/etiqueta_amarilla"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/campo_gps"
                android:textColor="@color/pixel_tinta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="11dp"
                android:background="@drawable/input_pixel"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/campo_latitud"
                    style="@style/TextoCorrido"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_latitud"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/pixel_tinta"
                    android:textColorHint="@color/pixel_hint"
                    android:textCursorDrawable="@drawable/cursor_pixel"
                    android:textSize="18sp" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/pixel_tinta" />

                <EditText
                    android:id="@+id/campo_longitud"
                    style="@style/TextoCorrido"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_longitud"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/pixel_tinta"
                    android:textColorHint="@color/pixel_hint"
                    android:textCursorDrawable="@drawable/cursor_pixel"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btn_gps"
                    style="@style/TextoEtiqueta"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:background="@color/pixel_azul"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/campo_gps"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- VALORACION -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:text="@string/campo_valoracion"
                android:textColor="@color/pixel_tinta" />

            <LinearLayout
                android:id="@+id/tira_valoracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-7dp"
                android:orientation="horizontal">

                <ImageView android:id="@+id/form_estrella_1" android:layout_width="44dp" android:layout_height="44dp" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/estrella_fav_inactiva" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/cd_estrella_una" />
                <ImageView android:id="@+id/form_estrella_2" android:layout_width="44dp" android:layout_height="44dp" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/estrella_fav_inactiva" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/cd_estrella_2" />
                <ImageView android:id="@+id/form_estrella_3" android:layout_width="44dp" android:layout_height="44dp" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/estrella_fav_inactiva" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/cd_estrella_3" />
                <ImageView android:id="@+id/form_estrella_4" android:layout_width="44dp" android:layout_height="44dp" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/estrella_fav_inactiva" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/cd_estrella_4" />
                <ImageView android:id="@+id/form_estrella_5" android:layout_width="44dp" android:layout_height="44dp" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/estrella_fav_inactiva" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/cd_estrella_5" />
            </LinearLayout>

            <!-- TIPO -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/etiqueta_amarilla"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/campo_tipo"
                android:textColor="@color/pixel_tinta" />

            <LinearLayout
                android:id="@+id/selector_tipo"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/input_pixel"
                android:contentDescription="@string/cd_tipo">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/pin_tipo"
                        android:layout_width="12dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY" />
                </FrameLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/pixel_tinta" />

                <TextView
                    android:id="@+id/texto_tipo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:fontFamily="@font/silkscreen"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/pixel_tinta"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/pixel_tinta" />

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="match_parent"
                    android:background="@color/pixel_tinta">
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="7dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/flecha_abajo_pixel" />
                </FrameLayout>
            </LinearLayout>

            <!-- NOTA -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/etiqueta_amarilla"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/campo_nota"
                android:textColor="@color/pixel_tinta" />

            <EditText
                android:id="@+id/campo_nota"
                style="@style/TextoCorrido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_pixel"
                android:gravity="top|start"
                android:hint="@string/hint_nota"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="88dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:textColor="@color/pixel_tinta"
                android:textColorHint="@color/pixel_hint"
                android:textCursorDrawable="@drawable/cursor_pixel"
                android:textSize="18sp" />

            <!-- FOTO -->
            <TextView
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/etiqueta_amarilla"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/campo_foto"
                android:textColor="@color/pixel_tinta" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Estado vacío: caja discontinua, mitad cámara / mitad galería -->
                <LinearLayout
                    android:id="@+id/foto_vacio"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/borde_discontinuo"
                    android:layerType="software"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/foto_camara"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_foto_camara" />

                        <TextView
                            style="@style/TextoEtiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/foto_camara"
                            android:textColor="@color/pixel_tinta" />
                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@color/pixel_tinta" />

                    <LinearLayout
                        android:id="@+id/foto_galeria"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_foto_galeria" />

                        <TextView
                            style="@style/TextoEtiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/foto_galeria"
                            android:textColor="@color/pixel_tinta" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Estado con foto: vista previa con marco -->
                <FrameLayout
                    android:id="@+id/foto_marco"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/borde_pixel"
                    android:padding="3dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/foto_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_foto_lugar"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <!-- Mini botones sobre la foto -->
                <LinearLayout
                    android:id="@+id/foto_acciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/foto_recamara"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/input_pixel"
                        android:contentDescription="@string/cd_tomar_otra_foto"
                        android:padding="6dp"
                        android:src="@drawable/ic_foto_camara" />

                    <ImageView
                        android:id="@+id/foto_regaleria"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/input_pixel"
                        android:contentDescription="@string/cd_elegir_otra_galeria"
                        android:padding="6dp"
                        android:src="@drawable/ic_foto_galeria" />

                    <ImageView
                        android:id="@+id/foto_borrar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/boton_foto_rojo"
                        android:contentDescription="@string/cd_quitar_foto"
                        android:padding="6dp"
                        android:src="@drawable/ic_foto_borrar" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Barra de acciones fija -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/pixel_tinta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/pixel_barra"
            android:padding="12dp">

            <TextView
                android:id="@+id/btn_eliminar"
                style="@style/TextoBoton"
                android:layout_width="96dp"
                android:layout_height="46dp"
                android:background="@drawable/boton_pixel_rojo"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0"
                android:text="@string/boton_eliminar"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/btn_guardar"
                style="@style/TextoBoton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/boton_pixel_verde"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/boton_guardar" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
