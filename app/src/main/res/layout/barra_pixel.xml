<?xml version="1.0" encoding="utf-8"?>
<!-- Barra superior retro de 40dp, reutilizable con <include>.
     - barra_atras: flecha atrás (ocultar con GONE en pantallas sin "atrás", p.ej. la lista)
     - barra_titulo: título en mayúsculas
     El que la incluye pone el texto del título y engancha el click de barra_atras. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/barra_fondo"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/pixel_azul"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/barra_atras"
            android:layout_width="18dp"
            android:layout_height="16dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/atras"
            android:src="@drawable/ic_flecha_atras" />

        <TextView
            android:id="@+id/barra_titulo"
            style="@style/TextoBarraTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Chip de acción opcional a la derecha (ej. "EDITAR" en el detalle).
             Oculto por defecto; la pantalla que lo use lo hace VISIBLE y le pone texto/click. -->
        <TextView
            android:id="@+id/barra_chip"
            style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/etiqueta_amarilla"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/pixel_tinta"
            android:visibility="gone" />

        <!-- Selector de idioma opcional a la derecha (solo lo usa la Lista).
             Oculto por defecto; la pantalla que lo use lo hace VISIBLE y lo cablea. -->
        <LinearLayout
            android:id="@+id/barra_idioma"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/fondo_boton_idioma"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="5dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_globo_pixel"
                android:tint="@color/pixel_fondo" />

            <TextView
                android:id="@+id/barra_idioma_texto"
                style="@style/TextoEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="@color/pixel_fondo" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="5dp"
                android:layout_marginStart="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/flecha_abajo_pixel"
                android:tint="@color/pixel_amarillo" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/pixel_tinta" />

</LinearLayout>
