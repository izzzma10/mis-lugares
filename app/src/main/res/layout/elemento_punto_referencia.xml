<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista de puntos de referencia cercanos (pantalla "CERCA"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/pixel_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/pr_pin"
            android:layout_width="12dp"
            android:layout_height="16dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@string/logo_del_tipo"
            android:src="@drawable/ic_pin_otros" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pr_nombre"
                style="@style/TextoNombreLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/pr_categoria"
                style="@style/TextoDireccionFila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pr_distancia"
            style="@style/TextoDistancia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/pixel_divisor" />

</LinearLayout>
