<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Fila de filtros -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/pixel_fondo"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/chip_todos"
            style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_pixel"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="28dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/filtro_todos"
            android:textColor="@color/chip_texto" />

        <TextView
            android:id="@+id/chip_fav"
            style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/chip_pixel"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="28dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/filtro_favoritos"
            android:textColor="@color/chip_texto" />

        <TextView
            android:id="@+id/chip_cerca"
            style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_pixel"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="28dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/filtro_cerca"
            android:textColor="@color/chip_texto" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/chip_az"
            style="@style/TextoEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_pixel_azul"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="28dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/filtro_az"
            android:textColor="@color/chip_texto_azul" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/pixel_tinta" />

    <!-- Buscador local por nombre (solo visible fuera del modo CERCA) -->
    <FrameLayout
        android:id="@+id/caja_filtro_texto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pixel_fondo"
        android:padding="8dp">

        <EditText
            android:id="@+id/campo_filtro_texto"
            style="@style/TextoCorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_pixel"
            android:hint="@string/hint_buscar_lista"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:minHeight="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/pixel_tinta"
            android:textColorHint="@color/pixel_hint"
            android:textCursorDrawable="@drawable/cursor_pixel"
            android:textSize="18sp" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/texto_vacio"
            style="@style/TextoCorrido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:gravity="center"
            android:text="@string/sin_puntos_cerca"
            android:textColor="@color/pixel_tinta_suave"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
