<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pixel_fondo">

    <include layout="@layout/barra_pixel" />

    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Banner de foto ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/foto"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:contentDescription="@string/cd_fotografia"
                    android:scaleType="centerCrop"
                    android:src="@drawable/foto_placeholder" />

                <!-- borde inferior -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:background="@color/pixel_tinta" />

                <!-- botones de foto -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/camara"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/input_pixel"
                        android:contentDescription="@string/cd_tomar_foto"
                        android:padding="6dp"
                        android:src="@drawable/ic_foto_camara" />

                    <ImageView
                        android:id="@+id/galeria"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/input_pixel"
                        android:contentDescription="@string/cd_elegir_galeria"
                        android:padding="6dp"
                        android:src="@drawable/ic_foto_galeria" />

                    <ImageView
                        android:id="@+id/eliminar_foto"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/boton_foto_rojo"
                        android:contentDescription="@string/cd_eliminar_foto"
                        android:padding="6dp"
                        android:src="@drawable/ic_foto_borrar" />
                </LinearLayout>

                <!-- etiqueta de tipo -->
                <TextView
                    android:id="@+id/tipo"
                    style="@style/TextoEtiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/etiqueta_tinta"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/pixel_fondo" />
            </FrameLayout>

            <!-- ===== Cabecera de texto ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/nombre"
                        style="@style/TextoNombreDetalle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/favorito"
                        android:layout_width="34dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/cd_favorito"
                        android:scaleType="fitXY"
                        android:src="@drawable/estrella_fav_inactiva" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:id="@+id/tira_valoracion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-5dp"
                        android:orientation="horizontal">

                        <ImageView android:id="@+id/det_estrella_1" android:layout_width="44dp" android:layout_height="44dp" android:padding="5dp" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/estrella_fav_inactiva" />
                        <ImageView android:id="@+id/det_estrella_2" android:layout_width="44dp" android:layout_height="44dp" android:padding="5dp" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/estrella_fav_inactiva" />
                        <ImageView android:id="@+id/det_estrella_3" android:layout_width="44dp" android:layout_height="44dp" android:padding="5dp" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/estrella_fav_inactiva" />
                        <ImageView android:id="@+id/det_estrella_4" android:layout_width="44dp" android:layout_height="44dp" android:padding="5dp" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/estrella_fav_inactiva" />
                        <ImageView android:id="@+id/det_estrella_5" android:layout_width="44dp" android:layout_height="44dp" android:padding="5dp" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/estrella_fav_inactiva" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/resumen_valoracion"
                        style="@style/TextoCorrido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:textColor="@color/pixel_azul" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Ficha de datos ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:background="@drawable/panel_pixel">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextoEtiqueta"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/etiqueta_tinta"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/etiqueta_dir"
                        android:textColor="@color/pixel_fondo" />

                    <TextView
                        android:id="@+id/direccion"
                        style="@style/TextoCorrido"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/pixel_tinta" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/pixel_divisor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextoEtiqueta"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/etiqueta_tinta"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/etiqueta_tel"
                        android:textColor="@color/pixel_fondo" />

                    <TextView
                        android:id="@+id/telefono"
                        style="@style/TextoCorrido"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/pixel_azul" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/pixel_divisor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextoEtiqueta"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/etiqueta_tinta"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/etiqueta_web"
                        android:textColor="@color/pixel_fondo" />

                    <TextView
                        android:id="@+id/url"
                        style="@style/TextoCorrido"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/pixel_azul" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/pixel_divisor" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextoEtiqueta"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/etiqueta_tinta"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/etiqueta_gps"
                        android:textColor="@color/pixel_fondo" />

                    <TextView
                        android:id="@+id/gps"
                        style="@style/TextoCorrido"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/pixel_tinta_suave" />
                </LinearLayout>

                <View
                    android:id="@+id/nota_divisor"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/pixel_divisor" />

                <LinearLayout
                    android:id="@+id/nota_fila"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextoEtiqueta"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/etiqueta_tinta"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/etiqueta_nota"
                        android:textColor="@color/pixel_fondo" />

                    <TextView
                        android:id="@+id/nota"
                        style="@style/TextoCorrido"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:textColor="@color/pixel_tinta" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Fila de 3 botones ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/btn_mapa"
                    style="@style/TextoBoton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:letterSpacing="0"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp"
                    android:textSize="10sp"
                    android:background="@drawable/boton_pixel_azul"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/boton_mapa" />

                <TextView
                    android:id="@+id/btnCompartir"
                    style="@style/TextoBoton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1.5"
                    android:maxLines="1"
                    android:letterSpacing="0"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp"
                    android:textSize="10sp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/boton_pixel_amarillo"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/boton_compartir"
                    android:textColor="@color/pixel_tinta" />

                <TextView
                    android:id="@+id/btn_llamar"
                    style="@style/TextoBoton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:letterSpacing="0"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp"
                    android:textSize="10sp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/boton_pixel_verde"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/boton_llamar" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
