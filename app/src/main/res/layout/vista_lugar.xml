<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:text="Nombres del Lugar"
            style="@style/TextoPixelCuerpo"
            android:textColor="@color/pixel_tinta"
            android:textSize="28sp"
             />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/logo_tipo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Logo del tipo"
                android:src="@drawable/ic_tipo" />

            <TextView
                android:id="@+id/tipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                style="@style/TextoPixelCuerpo"
                android:text="Tipo del Lugar" 
                android:textColor="@color/pixel_tinta"
                />

        </LinearLayout>

        <ImageView
            android:id="@+id/favorito"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:contentDescription="Favorito"
            android:src="@android:drawable/btn_star_big_off" />

        <TextView
            android:id="@+id/direccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Direccion del lugar"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            style="@style/TextoPixelCuerpo"
            android:textColor="@color/pixel_tinta"
            
             />

        <TextView
            android:id="@+id/telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telefono"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            style="@style/TextoPixelCuerpo"
            android:textColor="@color/pixel_tinta"
            
            />

        <TextView
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="URL"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            style="@style/TextoPixelCuerpo"
            android:textColor="@color/pixel_tinta"

            
            />

        <TextView
            android:id="@+id/gps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS: 0.0, 0.0"
            android:textSize="14sp"
            android:textColor="@color/pixel_azul"
            android:layout_marginTop="8dp"
            style="@style/TextoPixelCuerpo"

             />

        <RatingBar
            android:id="@+id/valoracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:rating="3" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/foto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="fotografia"
                android:src="@drawable/foto_epsg" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right">

                <ImageView
                    android:id="@+id/camara"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Logo camara"
                    android:src="@android:drawable/ic_menu_camera" />

                <ImageView
                    android:id="@+id/galeria"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Logo galeria"
                    android:src="@android:drawable/ic_menu_gallery" />

                <ImageView
                    android:id="@+id/eliminar_foto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Eliminar foto"
                    android:src="@android:drawable/ic_menu_delete" />

            </LinearLayout>

        </FrameLayout>

        <Button
            android:id="@+id/btnCompartir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Compartir"
            android:layout_marginTop="24dp" 
            
            android:background="@drawable/fondo_boton_pixel"
            android:backgroundTint="@color/pixel_amarillo" 
            style="@style/TextoPixelCuerpo"
            android:textColor="@color/pixel_tinta"
            />
        <Button
            android:id="@+id/btn_editar" 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"
            android:text="Editar" 
            android:layout_marginTop="8dp"

            android:background="@drawable/fondo_boton_pixel"
            android:backgroundTint="@color/pixel_rojo" 
            style="@style/TextoPixelCuerpo"
            android:textColor="@color/white"
            />

        <Button
            android:id="@+id/btn_mapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="mapa"
            android:layout_marginTop="8dp" 
            
            android:background="@drawable/fondo_boton_pixel"
            android:backgroundTint="@color/pixel_azul" 
            style="@style/TextoPixelCuerpo"
            android:textColor="@color/white"
            />

    </LinearLayout>

</ScrollView>
