<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/fondo_hoja_pixel">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/pixel_tinta"
        android:paddingStart="11dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/silkscreen"
            android:letterSpacing="0.1"
            android:text="@string/pref_idioma"
            android:textAllCaps="true"
            android:textColor="@color/pixel_fondo"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/hoja_cerrar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/cerrar"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_equis_pixel"
            android:tint="@color/pixel_amarillo" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lista_idiomas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
