<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".Aplicacion"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.MisLugares">

        <activity
            android:name=".presentacion.MenuActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentacion.MainActivity"
            android:exported="false" />

        <activity
            android:name=".presentacion.VistaLugarActivity"
            android:exported="false" />

        <activity
            android:name=".presentacion.EdicionLugarActivity"
            android:exported="false" />

        <activity
            android:name=".presentacion.PreferenciasActivity"
            android:exported="false"
            android:label="Preferencias" />

        <activity
            android:name=".presentacion.MapaLugarActivity"
            android:exported="false"
            android:label="Mapa" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

    </application>

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

</manifest>
